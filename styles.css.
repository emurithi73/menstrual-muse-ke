:root {
  --wine:#8f1648;
  --berry:#c51f68;
  --rose:#e83d79;
  --coral:#f36b65;
  --plum:#4c1741;
  --ink:#172033;
  --muted:#667085;
  --cream:#fff8f7;
  --paper:#ffffff;
  --line:#eadde4;
  --navy:#172d57;
  --teal:#177f78;
  --gold:#d69a2d;
  --shadow:0 18px 50px rgba(70, 24, 53, .10);
  --radius:22px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:linear-gradient(180deg,#fff8f7 0%,#fff 35%,#fff8fb 100%);line-height:1.65}
a{color:inherit}
img{max-width:100%;display:block}
.container{width:min(1160px,92%);margin:auto}
.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:1rem;top:1rem;z-index:1000;background:#fff;padding:.7rem 1rem;border-radius:10px}
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(16px);border-bottom:1px solid rgba(143,22,72,.10)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:78px}
.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;font-weight:900;color:var(--wine)}
.brand img{width:150px;height:auto}
.nav-links{display:flex;align-items:center;gap:.3rem;flex-wrap:wrap;justify-content:flex-end}.nav-links a{padding:.65rem .8rem;text-decoration:none;border-radius:999px;font-weight:750;color:#3e3340}.nav-links a:hover,.nav-links a[aria-current="page"]{background:#f9e6ef;color:var(--wine)}
.hero{padding:6.5rem 0 4.5rem;position:relative;overflow:hidden;background:radial-gradient(circle at 90% 10%,#f9c2d5 0,transparent 28%),radial-gradient(circle at 5% 20%,#ffe0bd 0,transparent 25%)}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:3rem;align-items:center}.eyebrow{display:inline-flex;gap:.5rem;align-items:center;color:var(--wine);font-weight:850;letter-spacing:.06em;text-transform:uppercase;font-size:.8rem}.eyebrow::before{content:"";width:28px;height:4px;border-radius:999px;background:linear-gradient(90deg,var(--berry),var(--gold))}
h1{font-size:clamp(2.8rem,6vw,5.5rem);line-height:.98;letter-spacing:-.055em;margin:.9rem 0 1.25rem;color:#241729}.hero h1 span{color:var(--berry)}.lead{font-size:1.2rem;color:#554b59;max-width:680px}
.actions{display:flex;gap:.8rem;flex-wrap:wrap;margin:1.8rem 0}.btn{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;border:0;border-radius:999px;padding:.82rem 1.15rem;font-weight:850;text-decoration:none;cursor:pointer;transition:.2s transform,.2s box-shadow}.btn:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(143,22,72,.16)}.btn-primary{background:var(--berry);color:#fff}.btn-dark{background:var(--navy);color:#fff}.btn-soft{background:#f9e6ef;color:var(--wine)}
.hero-card{background:rgba(255,255,255,.78);border:1px solid rgba(255,255,255,.9);border-radius:32px;padding:1rem;box-shadow:var(--shadow);transform:rotate(1deg)}.hero-card img{border-radius:24px;aspect-ratio:4/3;object-fit:cover}.caption{padding:.8rem .4rem .2rem;color:#655965;font-size:.9rem}
.section{padding:5rem 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:2rem}.section-head h2{margin:0;font-size:clamp(2rem,4vw,3rem);letter-spacing:-.035em}.section-head p{max-width:650px;color:var(--muted);margin:0}
.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:1.45rem;box-shadow:0 10px 35px rgba(55,25,43,.05)}.card h3{margin:.2rem 0 .5rem}.card p{color:#625766}.accent{border-top:5px solid var(--berry)}.accent.teal{border-top-color:var(--teal)}.accent.gold{border-top-color:var(--gold)}
.pill{display:inline-block;padding:.35rem .7rem;border-radius:999px;background:#f8e5ed;color:var(--wine);font-weight:800;font-size:.8rem}.checklist{padding:0;list-style:none}.checklist li{margin:.75rem 0;padding-left:1.6rem;position:relative}.checklist li::before{content:"✓";position:absolute;left:0;color:var(--berry);font-weight:900}
.action-panel{background:linear-gradient(135deg,#4c1741,#8f1648 58%,#c51f68);color:#fff;border-radius:32px;padding:2.2rem;box-shadow:var(--shadow)}.action-panel p{color:#ffeaf2}.action-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.action{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:1.1rem}.action a{color:#fff;font-weight:800}
.quote{font-size:1.5rem;font-weight:800;line-height:1.25;color:var(--plum);border-left:5px solid var(--coral);padding-left:1.1rem;margin:1.5rem 0}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.stat{padding:1.2rem;background:#fff;border:1px solid var(--line);border-radius:18px}.stat strong{display:block;font-size:1.8rem;color:var(--berry)}
.page-hero{padding:4rem 0 2.2rem;background:linear-gradient(135deg,#fff2f6,#fff8f7 50%,#eef9f7)}.page-hero h1{font-size:clamp(2.4rem,5vw,4.5rem)}
.topic{display:flex;gap:1rem;align-items:flex-start}.topic-icon{width:48px;height:48px;flex:0 0 48px;border-radius:15px;display:grid;place-items:center;background:#f9e6ef;color:var(--berry);font-size:1.3rem}
.faq{border:1px solid var(--line);border-radius:16px;background:#fff;margin:.7rem 0;overflow:hidden}.faq summary{cursor:pointer;padding:1rem 1.1rem;font-weight:850}.faq p{padding:0 1.1rem 1.1rem;margin:0;color:#5d5360}
.form{display:grid;gap:1rem}.field label{display:block;font-weight:800;margin-bottom:.35rem}.field input,.field textarea,.field select{width:100%;border:1px solid #dacbd3;border-radius:14px;padding:.9rem 1rem;font:inherit;background:#fff}.field textarea{min-height:150px;resize:vertical}
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.gallery figure{margin:0;background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 8px 25px rgba(55,25,43,.05)}.gallery img{width:100%;aspect-ratio:4/3;object-fit:cover}.gallery figcaption{padding:.8rem 1rem;font-size:.9rem;color:#5e5260}.gallery .wide{grid-column:span 2}
.contact-list{display:grid;gap:.7rem}.contact-list a{text-decoration:none;color:var(--navy);font-weight:800}.contact-list a:hover{color:var(--berry)}
.socials{display:flex;gap:.55rem;flex-wrap:wrap}.socials a{padding:.55rem .75rem;border:1px solid var(--line);border-radius:999px;text-decoration:none;font-weight:800;background:#fff}.socials a:hover{border-color:#d49ab5;color:var(--berry)}
.site-footer{background:#211529;color:#eee;padding:3rem 0 1.3rem;margin-top:3rem}.footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:2rem}.site-footer h3{color:#fff}.site-footer p,.site-footer a{color:#cfc3ce}.site-footer a{text-decoration:none}.site-footer a:hover{color:#fff}.copyright{border-top:1px solid rgba(255,255,255,.12);margin-top:2rem;padding-top:1rem;font-size:.85rem;color:#aa9daa}
.notice{padding:1rem 1.1rem;border-left:4px solid var(--gold);background:#fff8e9;border-radius:12px;color:#624f26}.small{font-size:.9rem;color:var(--muted)}
@media(max-width:900px){.hero-grid,.grid-2,.footer-grid{grid-template-columns:1fr}.grid-3,.action-grid,.stats{grid-template-columns:1fr 1fr}.gallery{grid-template-columns:1fr 1fr}.gallery .wide{grid-column:span 2}.nav{align-items:flex-start;padding:.7rem 0}.nav-links{gap:.1rem}}
@media(max-width:620px){.nav{flex-direction:column}.nav-links{width:100%;justify-content:flex-start}.nav-links a{font-size:.85rem}.hero{padding:4rem 0 3rem}.section{padding:3.5rem 0}.grid-3,.action-grid,.stats,.gallery{grid-template-columns:1fr}.gallery .wide{grid-column:auto}.hero-card{transform:none}.brand img{width:135px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
